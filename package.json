{
  "name": "kiro-whale-pet",
  "displayName": "KiroPet · 鲸鱼娘 AI 桌宠",
  "description": "鲸鱼娘 AI 桌宠：95 个透明动作、实时工作提示、左右吸附收起，个人非商业使用。",
  "version": "0.13.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify.js",
    "test:browser": "node test/browser-animation-check.js",
    "test:timing": "node test/animation-conformance.js"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "publisher": "local-whale-pet",
  "license": "SEE LICENSE IN THIRD_PARTY_ASSETS.md",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Kiro",
    "KiroPet",
    "whale",
    "desktop pet",
    "agent status",
    "桌宠"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kiroWhalePet.openMenu",
        "title": "鲸鱼娘：打开控制菜单"
      },
      {
        "command": "kiroWhalePet.show",
        "title": "鲸鱼娘：显示桌面悬浮窗"
      },
      {
        "command": "kiroWhalePet.openPanel",
        "title": "鲸鱼娘：打开编辑器内桌宠面板"
      },
      {
        "command": "kiroWhalePet.hide",
        "title": "鲸鱼娘：关闭桌面悬浮窗"
      },
      {
        "command": "kiroWhalePet.working",
        "title": "鲸鱼娘：工作状态"
      },
      {
        "command": "kiroWhalePet.done",
        "title": "鲸鱼娘：完成状态"
      },
      {
        "command": "kiroWhalePet.idle",
        "title": "鲸鱼娘：待机状态"
      },
      {
        "command": "kiroWhalePet.tool",
        "title": "鲸鱼娘：工具状态"
      },
      {
        "command": "kiroWhalePet.editing",
        "title": "鲸鱼娘：修改文件状态"
      },
      {
        "command": "kiroWhalePet.sleep",
        "title": "鲸鱼娘：休息状态"
      },
      {
        "command": "kiroWhalePet.checkLink",
        "title": "鲸鱼娘：诊断智能体事件联动"
      },
      {
        "command": "kiroWhalePet.installHooks",
        "title": "鲸鱼娘：为当前项目安装智能体事件联动"
      },
      {
        "command": "kiroWhalePet.installHooksAll",
        "title": "鲸鱼娘：为所有已打开项目安装智能体事件联动"
      },
      {
        "command": "kiroWhalePet.removeHooks",
        "title": "鲸鱼娘：移除当前项目联动"
      },
      {
        "command": "kiroWhalePet.toggleAutoStart",
        "title": "鲸鱼娘：切换自动启动"
      },
      {
        "command": "kiroWhalePet.checkSessions",
        "title": "鲸鱼娘：诊断本地会话监听"
      },
      {
        "command": "kiroWhalePet.behavior",
        "title": "鲸鱼娘：活跃度与动作设置"
      }
    ],
    "configuration": {
      "title": "Kiro 鲸鱼娘桌宠",
      "properties": {
        "kiroWhalePet.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Kiro 启动后自动显示桌面悬浮窗；macOS/Linux 需安装 Python 3 与 Tk。"
        },
        "kiroWhalePet.size": {
          "type": "number",
          "default": 140,
          "minimum": 100,
          "maximum": 320,
          "description": "桌宠显示框尺寸（像素）。修改后重新打开生效，并优先于已保存的右键菜单尺寸。"
        },
        "kiroWhalePet.autoInstallHooksNewProjects": {
          "type": "boolean",
          "default": false,
          "description": "已授权后，为随后新打开的本地工作区自动安装鲸鱼娘项目 Hook（默认关闭）。"
        },
        "kiroWhalePet.desktopMode": {
          "type": "string",
          "enum": [
            "auto",
            "panel"
          ],
          "default": "auto",
          "description": "自动选择：优先显示桌面悬浮窗，缺少运行环境时使用编辑器面板；编辑器内面板：只在编辑器中显示。",
          "enumItemLabels": [
            "自动选择",
            "编辑器内面板"
          ]
        },
        "kiroWhalePet.localSessions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "方案 A：只读监听当前本地项目的 Kiro 会话记录，无需安装 Hook。只对启动后写入的新事件联动。"
        },
        "kiroWhalePet.localSessions.directory": {
          "type": "string",
          "default": "",
          "description": "Kiro sessions 根目录。留空使用用户主目录下的 .kiro/sessions；不支持旧版 globalStorage 历史格式。"
        },
        "kiroWhalePet.localSessions.showReplyPreview": {
          "type": "boolean",
          "default": true,
          "description": "气泡显示已落盘回答的最新一两句（最多 90 字符），结束后停留 8 秒。摘录写入本地状态文件，不调用模型。不显示 Reasoning、提示词或工具结果；并非逐 token 实时流。"
        },
        "kiroWhalePet.behavior.mode": {
          "type": "string",
          "enum": [
            "quiet",
            "balanced",
            "lively"
          ],
          "enumItemLabels": [
            "安静",
            "均衡",
            "活泼"
          ],
          "default": "balanced",
          "description": "控制空闲随机动作的间隔；工作、等待确认和报错仍由真实事件触发。"
        },
        "kiroWhalePet.behavior.pools": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "description": "通过“鲸鱼娘：活跃度与动作设置”选择各状态的动作。每次进入状态随机选择一个，连续同类事件不重复抽取。空池恢复默认。"
        },
        "kiroWhalePet.behavior.excluded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "description": "禁止自动抽取的动作；可用中文多选菜单设置。手动预览不受影响，全部排除时使用呼吸保底。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/w47403/KiroPet.git"
  },
  "homepage": "https://github.com/w47403/KiroPet#readme",
  "bugs": {
    "url": "https://github.com/w47403/KiroPet/issues"
  }
}
