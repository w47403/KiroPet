{
  "name": "kiro-whale-pet",
  "displayName": "KiroPet · 鲸鱼娘 AI 桌宠",
  "description": "鲸鱼娘 AI 桌宠：95 个透明动作、实时工作提示、左右吸附收起，个人非商业使用。",
  "version": "0.12.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify.js",
    "test:browser": "node test/browser-animation-check.js",
    "test:timing": "node test/animation-conformance.js"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "publisher": "local-whale-pet",
  "license": "SEE LICENSE IN THIRD_PARTY_ASSETS.md",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Kiro",
    "KiroPet",
    "whale",
    "desktop pet",
    "agent status",
    "桌宠"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kiroWhalePet.openMenu",
        "title": "鲸鱼娘：打开控制菜单"
      },
      {
        "command": "kiroWhalePet.show",
        "title": "鲸鱼娘：显示桌面悬浮窗"
      },
      {
        "command": "kiroWhalePet.openPanel",
        "title": "鲸鱼娘：打开 Kiro 内桌宠面板"
      },
      {
        "command": "kiroWhalePet.hide",
        "title": "鲸鱼娘：关闭桌面悬浮窗"
      },
      {
        "command": "kiroWhalePet.working",
        "title": "鲸鱼娘：工作状态"
      },
      {
        "command": "kiroWhalePet.done",
        "title": "鲸鱼娘：完成状态"
      },
      {
        "command": "kiroWhalePet.idle",
        "title": "鲸鱼娘：待机状态"
      },
      {
        "command": "kiroWhalePet.tool",
        "title": "鲸鱼娘：工具状态"
      },
      {
        "command": "kiroWhalePet.editing",
        "title": "鲸鱼娘：修改文件状态"
      },
      {
        "command": "kiroWhalePet.sleep",
        "title": "鲸鱼娘：休息状态"
      },
      {
        "command": "kiroWhalePet.checkLink",
        "title": "鲸鱼娘：诊断 Agent Hook 联动"
      },
      {
        "command": "kiroWhalePet.installHooks",
        "title": "鲸鱼娘：为当前项目安装 Agent Hooks"
      },
      {
        "command": "kiroWhalePet.installHooksAll",
        "title": "鲸鱼娘：为所有已打开项目安装 Agent Hooks"
      },
      {
        "command": "kiroWhalePet.removeHooks",
        "title": "鲸鱼娘：移除当前项目联动"
      },
      {
        "command": "kiroWhalePet.toggleAutoStart",
        "title": "鲸鱼娘：切换自动启动"
      },
      {
        "command": "kiroWhalePet.checkSessions",
        "title": "鲸鱼娘：诊断本地会话监听"
      }
    ],
    "configuration": {
      "title": "Kiro 鲸鱼娘桌宠",
      "properties": {
        "kiroWhalePet.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Kiro 启动后自动显示桌面悬浮窗；macOS/Linux 需安装 Python 3 与 Tk。"
        },
        "kiroWhalePet.size": {
          "type": "number",
          "default": 140,
          "minimum": 100,
          "maximum": 320,
          "description": "桌宠显示框尺寸（像素）。修改后重新打开生效，并优先于已保存的右键菜单尺寸。"
        },
        "kiroWhalePet.autoInstallHooksNewProjects": {
          "type": "boolean",
          "default": false,
          "description": "已授权后，为随后新打开的本地工作区自动安装鲸鱼娘项目 Hook（默认关闭）。"
        },
        "kiroWhalePet.desktopMode": {
          "type": "string",
          "enum": [
            "auto",
            "panel"
          ],
          "default": "auto",
          "description": "auto: 启动系统悬浮窗（缺少桌面运行环境时退回 Kiro 面板）；panel: 只使用跨平台 Kiro 内面板。"
        },
        "kiroWhalePet.localSessions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "方案 A：只读监听当前本地项目的 Kiro 会话记录，无需安装 Hook。只对启动后写入的新事件联动。"
        },
        "kiroWhalePet.localSessions.directory": {
          "type": "string",
          "default": "",
          "description": "Kiro sessions 根目录。留空使用用户主目录下的 .kiro/sessions；不支持旧版 globalStorage 历史格式。"
        },
        "kiroWhalePet.localSessions.showReplyPreview": {
          "type": "boolean",
          "default": true,
          "description": "气泡显示已落盘回答的最新一两句（最多 90 字符），结束后停留 8 秒。摘录写入本地状态文件，不调用模型。不显示 Reasoning、提示词或工具结果；并非逐 token 实时流。"
        }
      }
    }
  }
}
